; thumbnail end
; THUMBNAIL_BLOCK_END

; external perimeters extrusion width = 0.40mm
; perimeters extrusion width = 0.45mm
; infill extrusion width = 0.45mm
; solid infill extrusion width = 0.40mm
; top infill extrusion width = 0.40mm
; support material extrusion width = 0.40mm
; first layer extrusion width = 0.50mm

; EXECUTABLE_BLOCK_START
M486 S0 A"Starman_print.stl_id_0_copy_0"
M486 S-1
M73 P0 R34
M201 X20000 Y20000 Z500 E5000
M203 X30000 Y30000 Z720 E1500
M204 P20000 T20000 ; sets acceleration (P, T), mm/sec^2
M566 X540.00 Y540.00 Z12.00 E150.00 ; sets the jerk limits, mm/min
;TYPE:Custom
; Prime Filament Sensor for Runout
M581 P1 T2 S-1 R0
M950 J1 C"nil" ; Input 1 e0 Filament Sensor 
M591 D0 P2 C"e0stop" S1 ; Filament Runout Sensor

M83  ; extruder relative mode

M140 S55 ; set bed temp
M109 S140 ; Set extruder temp 140C before bed level
M190 S55 ; wait for bed temp

;G28 W
G32 ; Levels Z Tilt and probes Z=0
G29 S0 ; mesh bed leveling
G1 X0 Y0 Z2 F2000
M109 S220 ; wait for extruder temp

G1 X10 Y-7 Z0.3 F1000.0 ; go outside print area
M73 P12 R30
G92 E0.0
G1 Z0.2 E8 ; Purge Bubble
G1 X60.0 E9.0  F1000.0 ; intro line
G1 X100.0 E12.5  F1000.0 ; intro line
G92 E0.0
G90
G21
M83 ; use relative distances for extrusion
; Filament gcode
M106 S0
;LAYER_CHANGE
;Z:0.2
;HEIGHT:0.2
;BEFORE_LAYER_CHANGE
;0.2
G92 E0

G1 E-.8 F1800
